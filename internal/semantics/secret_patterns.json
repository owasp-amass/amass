{
  "_license": "Copyright © by Jeff Foley 2017-2026. All rights reserved. Use of this source code is governed by Apache 2 LICENSE that can be found in the LICENSE file. SPDX-License-Identifier: Apache-2.0",
  "_about": "The public formats of credentials and cloud identifiers Amass recognizes in what it collects, each from its provider's own documentation (source). A pattern's group is the capture holding the value. A pattern with an id_type finds an identifier, not a secret: an AWS access key ID or account ID names the key or account and is stored in full. Any other pattern finds a secret, which is never stored, logged or sent to a model: only its kind, a SHA-256 of its value and a masked preview are kept, and text sent to models has it masked. A secret is kept only when its Shannon entropy is at least min_entropy bits per character, so placeholders (xoxb-xxxxxxxx) are not reported, and never when it is one of ignore_values or contains one of ignore_substrings (documentation examples). Found credentials are never used or tested.",
  "patterns": [
    {"kind": "aws_access_key_id", "title": "AWS access key ID", "pattern": "\\b((?:AKIA|ASIA)[A-Z2-7]{16})\\b", "group": 1,
      "id_type": "aws_access_key_id", "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_identifiers.html#identifiers-unique-ids"},
    {"kind": "aws_account_id", "title": "AWS account ID", "pattern": "\\barn:aws[a-z-]*:[a-z0-9-]+:[a-z0-9-]*:([0-9]{12}):", "group": 1,
      "id_type": "aws_account_id", "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference-arns.html"},
    {"kind": "aws_secret_access_key", "title": "AWS secret access key", "pattern": "(?i)aws.{0,20}?(?:secret|sk).{0,20}?['\"=:\\s]+([A-Za-z0-9/+]{40})(?:[^A-Za-z0-9/+]|$)", "group": 1,
      "min_entropy": 4.0, "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/id_credentials_access-keys.html"},
    {"kind": "github_token", "title": "GitHub token", "pattern": "\\b((?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{82})\\b", "group": 1,
      "min_entropy": 3.5, "source": "https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/about-authentication-to-github#githubs-token-formats"},
    {"kind": "gitlab_token", "title": "GitLab personal access token", "pattern": "\\b(glpat-[A-Za-z0-9_-]{20,})\\b", "group": 1,
      "min_entropy": 3.5, "source": "https://docs.gitlab.com/ee/security/tokens/"},
    {"kind": "slack_token", "title": "Slack token", "pattern": "\\b(xox[abprs]-[A-Za-z0-9-]{10,})\\b", "group": 1,
      "min_entropy": 3.0, "source": "https://api.slack.com/authentication/token-types"},
    {"kind": "stripe_secret_key", "title": "Stripe live secret key", "pattern": "\\b((?:sk|rk)_live_[A-Za-z0-9]{24,})\\b", "group": 1,
      "min_entropy": 3.5, "source": "https://docs.stripe.com/keys"},
    {"kind": "google_api_key", "title": "Google API key", "pattern": "\\b(AIza[0-9A-Za-z_-]{35})(?:[^0-9A-Za-z_-]|$)", "group": 1,
      "min_entropy": 3.5, "source": "https://cloud.google.com/docs/authentication/api-keys"},
    {"kind": "npm_token", "title": "npm access token", "pattern": "\\b(npm_[A-Za-z0-9]{36})\\b", "group": 1,
      "min_entropy": 3.5, "source": "https://docs.npmjs.com/about-access-tokens"},
    {"kind": "sendgrid_api_key", "title": "SendGrid API key", "pattern": "\\b(SG\\.[A-Za-z0-9_-]{22}\\.[A-Za-z0-9_-]{43})(?:[^A-Za-z0-9_-]|$)", "group": 1,
      "min_entropy": 3.5, "source": "https://www.twilio.com/docs/sendgrid/ui/account-and-settings/api-keys"},
    {"kind": "private_key", "title": "Private key", "pattern": "(-----BEGIN (?:RSA |EC |DSA |OPENSSH |ENCRYPTED )?PRIVATE KEY-----[A-Za-z0-9+/=\\s]{64,}?-----END (?:RSA |EC |DSA |OPENSSH |ENCRYPTED )?PRIVATE KEY-----)", "group": 1,
      "min_entropy": 3.0, "source": "https://www.rfc-editor.org/rfc/rfc7468"}
  ],
  "ignore_values": ["AKIAIOSFODNN7EXAMPLE", "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"],
  "ignore_substrings": ["EXAMPLE", "example", "XXXXXXXX", "xxxxxxxx", "0000000000000000"]
}
