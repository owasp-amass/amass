{
  "_license": "Copyright © by Jeff Foley 2017-2026. All rights reserved. Use of this source code is governed by Apache 2 LICENSE that can be found in the LICENSE file. SPDX-License-Identifier: Apache-2.0",
  "_about": "How the services lens identifies the software a stored service runs from what its probe stored. A fingerprint matches either the value of a response header (header, compared without case) or the banner a service sent (banner: true, the service's stored output, read only for the listed service_types). pattern is a regular expression matched without case; version names the capture group holding the version, 0 when the pattern captures none. Each fingerprint cites the documentation that describes what the software sends. Identification is computed when asked and never written to the Asset Database: the stored header or banner is the evidence, and software can hide or fake it. Add values here, not in Go code.",
  "fingerprints": [
    {"product": "nginx", "vendor": "F5, Inc.", "header": "server",
      "pattern": "^nginx(?:/([0-9][0-9A-Za-z.]*))?", "version": 1,
      "source": "https://documentation.ubuntu.com/security/security-features/network/version-banners/nginx/"},
    {"product": "Apache HTTP Server", "vendor": "Apache Software Foundation", "header": "server",
      "pattern": "^Apache(?:/([0-9][0-9A-Za-z.]*))?", "version": 1,
      "source": "https://documentation.ubuntu.com/security/security-features/network/version-banners/apache2/"},
    {"product": "Microsoft IIS", "vendor": "Microsoft Corporation", "header": "server",
      "pattern": "^Microsoft-IIS(?:/([0-9][0-9.]*))?", "version": 1,
      "source": "https://techcommunity.microsoft.com/blog/iis-support-blog/remove-unwanted-http-response-headers/369710"},
    {"product": "ASP.NET", "vendor": "Microsoft Corporation", "header": "x-powered-by",
      "pattern": "^ASP\\.NET$", "version": 0,
      "source": "https://techcommunity.microsoft.com/blog/iis-support-blog/remove-unwanted-http-response-headers/369710"},
    {"product": "ASP.NET", "vendor": "Microsoft Corporation", "header": "x-aspnet-version",
      "pattern": "^([0-9][0-9.]*)$", "version": 1,
      "source": "https://techcommunity.microsoft.com/blog/iis-support-blog/remove-unwanted-http-response-headers/369710"},
    {"product": "PHP", "vendor": "The PHP Group", "header": "x-powered-by",
      "pattern": "^PHP(?:/([0-9][0-9A-Za-z.\\-]*))?", "version": 1,
      "source": "https://php.net/manual/en/security.hiding.php"},
    {"product": "PHP", "vendor": "The PHP Group", "header": "server",
      "pattern": "\\bPHP/([0-9][0-9A-Za-z.\\-]*)", "version": 1,
      "source": "https://httpd.apache.org/docs/2.4/mod/core.html#servertokens"},
    {"product": "OpenSSL", "vendor": "OpenSSL Foundation", "header": "server",
      "pattern": "\\bOpenSSL/([0-9][0-9A-Za-z.]*)", "version": 1,
      "source": "https://httpd.apache.org/docs/2.4/mod/core.html#servertokens"},
    {"product": "Express", "vendor": "OpenJS Foundation", "header": "x-powered-by",
      "pattern": "^Express$", "version": 0,
      "source": "https://expressjs.com/en/advanced/best-practice-security.html"},
    {"product": "OpenSSH", "vendor": "OpenBSD Project", "banner": true, "service_types": ["ssh"],
      "pattern": "^SSH-[0-9.]+-OpenSSH_([0-9][0-9A-Za-z.]*)", "version": 1,
      "source": "https://documentation.ubuntu.com/security/security-features/network/version-banners/openssh-server/"},
    {"product": "Postfix", "vendor": "Postfix project", "banner": true, "service_types": ["smtp"],
      "pattern": "^220[ -]\\S+ ESMTP Postfix", "version": 0,
      "source": "https://man.archlinux.org/man/extra/postfix/smtpd.8.en"},
    {"product": "Exim", "vendor": "Exim project", "banner": true, "service_types": ["smtp"],
      "pattern": "^220[ -]\\S+ ESMTP Exim ([0-9][0-9.]*)", "version": 1,
      "source": "https://lists.exim.org/lurker/message/20041222.120546.5dda7cb4.pl.html"},
    {"product": "Microsoft Exchange Server", "vendor": "Microsoft Corporation", "banner": true,
      "service_types": ["smtp"], "pattern": "^220[ -]\\S+ Microsoft ESMTP MAIL service ready", "version": 0,
      "source": "https://learn.microsoft.com/en-us/exchange/mail-flow/connectors/modify-smtp-banners"},
    {"product": "vsftpd", "vendor": "vsftpd project", "banner": true, "service_types": ["ftp"],
      "pattern": "^220 \\(vsFTPd ([0-9][0-9.]*)\\)", "version": 1,
      "source": "https://documentation.ubuntu.com/security/security-features/network/version-banners/vsftpd/"},
    {"product": "Dovecot", "vendor": "Open-Xchange", "banner": true, "service_types": ["pop3", "imap"],
      "pattern": "Dovecot( \\([^)]*\\))? ready", "version": 0,
      "source": "https://dovecot.org/doc/dovecot-example.conf"},
    {"product": "Drupal", "vendor": "Drupal Association", "header": "x-generator",
      "pattern": "^Drupal ([0-9]+) \\(https://www\\.drupal\\.org\\)", "version": 1,
      "source": "https://api.drupal.org/api/drupal/core!lib!Drupal!Core!EventSubscriber!ResponseGeneratorSubscriber.php/11.3.x"},
    {"product": "Apache Traffic Server", "vendor": "Apache Software Foundation", "header": "server",
      "pattern": "^ATS(?:/([0-9][0-9A-Za-z.]*))?$", "version": 1,
      "source": "https://docs.trafficserver.apache.org/admin-guide/files/records.yaml.en.html"},
    {"product": "Phusion Passenger", "vendor": "Phusion", "header": "x-powered-by",
      "pattern": "^Phusion Passenger(?:\\(R\\))?(?: ([0-9][0-9.]*))?", "version": 1,
      "source": "https://www.phusionpassenger.com/library/config/nginx/reference"},
    {"product": "Phusion Passenger", "vendor": "Phusion", "header": "server",
      "pattern": "\\bPhusion[ _]Passenger(?:\\(R\\))?(?:[ /]([0-9][0-9.]*))?", "version": 1,
      "source": "https://www.phusionpassenger.com/library/config/nginx/reference"},
    {"product": "Next.js", "vendor": "Vercel", "header": "x-powered-by",
      "pattern": "^Next\\.js$", "version": 0,
      "source": "https://nextjs.org/docs/app/api-reference/config/next-config-js/poweredByHeader"},
    {"product": "mod_perl", "vendor": "Apache Software Foundation", "header": "server",
      "pattern": "\\bmod_perl/([0-9][0-9A-Za-z._-]*)", "version": 1,
      "source": "https://perl.apache.org/docs/2.0/api/Apache2/ServerUtil.html"},
    {"product": "Perl", "vendor": "Perl Foundation", "header": "server",
      "pattern": "\\bPerl/v?([0-9][0-9.]*)", "version": 1,
      "source": "https://perl.apache.org/docs/2.0/api/Apache2/ServerUtil.html"}
  ]
}
