# Binaries for programs and plugins
*.exe
*.dll
*.so
*.dylib

# Output from Amass tooling
*.json
*.log
*.html

# Test binary, build with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Project-local glide cache, RE: https://github.com/Masterminds/glide/issues/736
.glide/

# Jetbrains IDE configuration files
.idea
# Embedded data: lens and AI semantics, the question evaluation set and probe catalogs
!internal/semantics/*.json
!internal/ai/questions/*.json
!engine/plugins/service_discovery/banner_probes/*.json
